-- Note table schema for SQLDelight
CREATE TABLE NoteEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    is_favorite INTEGER NOT NULL DEFAULT 0
);

-- Select all notes ordered by updated_at descending
selectAll:
SELECT * FROM NoteEntity ORDER BY updated_at DESC;

-- Select all notes ordered by title ascending
selectAllByTitle:
SELECT * FROM NoteEntity ORDER BY title ASC;

-- Select all notes ordered by created_at descending
selectAllByCreatedAt:
SELECT * FROM NoteEntity ORDER BY created_at DESC;

-- Select note by id
selectById:
SELECT * FROM NoteEntity WHERE id = ?;

-- Insert new note
insert:
INSERT INTO NoteEntity(title, content, created_at, updated_at, is_favorite)
VALUES (?, ?, ?, ?, 0);

-- Update note
update:
UPDATE NoteEntity SET title = ?, content = ?, updated_at = ? WHERE id = ?;

-- Delete note
delete:
DELETE FROM NoteEntity WHERE id = ?;

-- Search notes by title or content
search:
SELECT * FROM NoteEntity WHERE title LIKE ? OR content LIKE ? ORDER BY updated_at DESC;

-- Toggle favorite
toggleFavorite:
UPDATE NoteEntity SET is_favorite = CASE WHEN is_favorite = 0 THEN 1 ELSE 0 END WHERE id = ?;

-- Select favorite notes
selectFavorites:
SELECT * FROM NoteEntity WHERE is_favorite = 1 ORDER BY updated_at DESC;
